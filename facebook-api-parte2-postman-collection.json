        {
          "name": "Crear 10 posts más",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Crea 9 posts más con el token de A; esta request crea el décimo (11 en total)",
                  "for (let i = 1; i <= 9; i++) {",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get(\"base_url\") + \"/api/v1/posts\",",
                  "        method: \"POST\",",
                  "        header: { \"Accept\": \"application/json\", \"Authorization\": \"Bearer \" + pm.collectionVariables.get(\"token\") },",
                  "        body: { mode: \"urlencoded\", urlencoded: [",
                  "            { key: \"title\", value: \"Post de prueba \" + i },",
                  "            { key: \"content\", value: i === 3 ? \"Hoy en la facultad vimos Laravel\" : \"Contenido \" + i }",
                  "        ]}",
                  "    }, (err, res) => pm.test(\"Post extra \" + i + \" → 201\", () => pm.expect(res.code).to.eql(201)));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Se crearon los 10 posts extra\", () => pm.expect(pm.response.json().title).to.eql(\"Post de prueba 10\"));"
                ]
              }
            }
          ],
